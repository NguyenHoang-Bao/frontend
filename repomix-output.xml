  const isAuthPage = authRoutes.includes(location.pathname.toLowerCase().replace(/\/$/, '')) || authRoutes.includes(location.pathname);

  // Khóa thanh cuộn trang khi ở các trang xác thực (login, register, forgot-password)
  useEffect(() => {
