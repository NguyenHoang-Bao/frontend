                  htmlFor={`price-${price.id}`} 
                  className={`ml-2 cursor-pointer transition-colors ${
                    priceFilter === price.id ? 'text-rose-600 font-bold' : 'text-gray-600 hover:text-gray-900'
                  }`}
                >
                  {price.label}
                </label>
              </div>
            ))}
          </div>
        </div>
      </div>
    </aside>
  );
}
